<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, Android 8 and newer.

     The launcher masks these two layers to whatever shape the device uses —
     circle, squircle, teardrop — and animates them independently. Supplying
     them is what stops Android drawing our square bitmap inside a white
     rounded blob, which is how the previous icon appeared on most phones.

     The background is a bitmap rather than a flat colour because it carries
     the brand gradient; a solid fill would flatten it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
